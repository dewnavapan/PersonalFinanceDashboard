@model PersonalFinance.Application.ViewModels.Auth.LoginViewModel
@{
    ViewData["Title"] = "เข้าสู่ระบบ";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h3 class="text-center mb-4">เข้าสู่ระบบ</h3>
                
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                }

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">อีเมล</label>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">รหัสผ่าน</label>
                        <input asp-for="Password" class="form-control" type="password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">จดจำการเข้าสู่ระบบ</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-3">เข้าสู่ระบบ</button>
                    
                    <div class="text-center">
                        <span class="text-muted">ยังไม่มีบัญชี?</span> 
                        <a asp-action="Register">สมัครสมาชิก</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
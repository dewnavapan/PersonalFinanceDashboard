@model PersonalFinance.Application.ViewModels.Transaction.TransactionFormViewModel
@{
    ViewData["Title"] = "บันทึกรายการใหม่";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">บันทึกธุรกรรมทางการเงิน</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label">ประเภท</label>
                            <select asp-for="Type" class="form-select" id="transactionType">
                                <option value="Expense">รายจ่าย (Expense)</option>
                                <option value="Income">รายรับ (Income)</option>
                                <option value="TransferOut">โอนเงิน (Transfer)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">บัญชี</label>
                            <select asp-for="AccountId" class="form-select" asp-items="ViewBag.Accounts">
                                <option value="">-- เลือกบัญชี --</option>
                            </select>
                            <span asp-validation-for="AccountId" class="text-danger"></span>
                        </div>

                        <div class="mb-3" id="categoryGroup">
                            <label class="form-label">หมวดหมู่</label>
                            <select asp-for="CategoryId" class="form-select" id="categorySelect">
                                <option value="">-- เลือกหมวดหมู่ --</option>
                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var cat in ViewBag.Categories)
                                    {
                                        <option value="@cat.Id" data-type="@cat.Type">@cat.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- จำนวนเงิน และ วันที่ -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">จำนวนเงิน (บาท)</label>
                                <input asp-for="Amount" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="Amount" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">วันที่</label>
                                <input asp-for="Date" class="form-control" type="date" />
                            </div>
                        </div>

                        <!-- คำอธิบาย -->
                        <div class="mb-3">
                            <label class="form-label">บันทึกช่วยจำ (ทางเลือก)</label>
                            <input asp-for="Description" class="form-control" placeholder="เช่น ค่าอาหารกลางวัน, เงินเดือนเข้า..." />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">บันทึกข้อมูล</button>
                            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-light">ยกเลิก</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const typeSelect = document.getElementById("transactionType");
            const categorySelect = document.getElementById("categorySelect");
            const categoryGroup = document.getElementById("categoryGroup");

            function filterCategories() {
                const selectedType = typeSelect.value;
                let hasVisibleOptions = false;

                // ซ่อนหมวดหมู่ถ้าเป็นการโอนเงิน
                if (selectedType === "TransferOut") {
                    categoryGroup.style.display = "none";
                    categorySelect.value = "";
                } else {
                    categoryGroup.style.display = "block";
                    // วนลูปซ่อน/แสดงหมวดหมู่ตามประเภท
                    Array.from(categorySelect.options).forEach(option => {
                        if (option.value === "") return; // ข้ามตัวเลือก default

                        if (option.getAttribute("data-type") === selectedType) {
                            option.style.display = "";
                            hasVisibleOptions = true;
                        } else {
                            option.style.display = "none";
                        }
                    });

                    // รีเซ็ตค่าถ้าหมวดหมู่ที่เลือกไว้ถูกซ่อน
                    const currentOpt = categorySelect.options[categorySelect.selectedIndex];
                    if (currentOpt && currentOpt.style.display === "none") {
                        categorySelect.value = "";
                    }
                }
            }

            typeSelect.addEventListener("change", filterCategories);
            filterCategories(); // เรียกตอนโหลดหน้าครั้งแรก
        });
    </script>
}
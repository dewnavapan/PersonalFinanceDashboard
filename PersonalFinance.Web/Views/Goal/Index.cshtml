@model IEnumerable<PersonalFinance.Application.ViewModels.Goal.GoalProgressViewModel>
@{
    ViewData["Title"] = "เป้าหมายการออม";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>เป้าหมายการออมของคุณ</h2>
        <a asp-action="Create" class="btn btn-primary">+ สร้างเป้าหมายใหม่</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm h-100 border-0">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="card-title text-primary mb-0"><i class="bi bi-star-fill text-warning me-2"></i>@item.Name</h5>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-calendar-event me-1"></i>@item.TargetDate.ToString("MMM yyyy")
                                </span>
                            </div>

                            <h3 class="mb-1">฿@item.CurrentAmount.ToString("N0")</h3>
                            <p class="text-muted small mb-3">เป้าหมาย: ฿@item.TargetAmount.ToString("N0")</p>

                            <div class="progress mb-3" style="height: 12px; border-radius: 10px;">
                                <div class="progress-bar bg-success" role="progressbar" 
                                     style="width: @item.ProgressPercentage%;" 
                                     aria-valuenow="@item.ProgressPercentage" aria-valuemin="0" aria-valuemax="100">
                                </div>
                            </div>
                            
                            <div class="d-flex justify-content-between small mb-3">
                                <span class="text-success fw-bold">@item.ProgressPercentage.ToString("0.0")% สำเร็จ</span>
                                <span class="text-muted">เหลือ @item.MonthsRemaining เดือน</span>
                            </div>

                            <div class="alert alert-info py-2 px-3 small text-center mb-4">
                                💡 ควรเก็บเพิ่มเดือนละ <strong>฿@item.RequiredMonthlySaving.ToString("N0")</strong>
                            </div>

                            <div class="d-flex justify-content-between gap-2">
                                <form asp-action="AddFund" method="post" class="d-flex w-100 gap-2">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="number" name="addAmount" class="form-control form-control-sm" placeholder="จำนวนเงิน" required min="1" step="0.01">
                                    <button type="submit" class="btn btn-sm btn-success text-nowrap">หยอดกระปุก</button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('ต้องการลบเป้าหมายนี้ใช่หรือไม่?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> ลบ</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center text-muted mt-5">
                <p>ยังไม่มีเป้าหมายการออม สร้างเป้าหมายแรกของคุณเพื่อเริ่มต้นวางแผนการเงินที่ดี</p>
                <a asp-action="Create" class="btn btn-outline-primary">คลิกเพื่อสร้างเป้าหมาย</a>
            </div>
        }
    </div>
</div>
@model PersonalFinance.Application.ViewModels.Goal.GoalFormViewModel
@{
    ViewData["Title"] = "สร้างเป้าหมายการออม";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">กำหนดเป้าหมายใหม่</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">ชื่อเป้าหมาย (เช่น กองทุนฉุกเฉิน, ดาวน์รถ)</label>
                            <input asp-for="Name" class="form-control" placeholder="ระบุชื่อเป้าหมาย" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="TargetAmount" class="form-label">จำนวนเงินเป้าหมาย (บาท)</label>
                                <input asp-for="TargetAmount" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="TargetAmount" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CurrentAmount" class="form-label">เงินออมตั้งต้น (บาท)</label>
                                <input asp-for="CurrentAmount" class="form-control" type="number" step="0.01" value="0" />
                                <span asp-validation-for="CurrentAmount" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="TargetDate" class="form-label">วันที่ต้องการบรรลุเป้าหมาย</label>
                            <input asp-for="TargetDate" class="form-control" type="date" />
                            <span asp-validation-for="TargetDate" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-outline-secondary">ยกเลิก</a>
                            <button type="submit" class="btn btn-primary">บันทึกเป้าหมาย</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
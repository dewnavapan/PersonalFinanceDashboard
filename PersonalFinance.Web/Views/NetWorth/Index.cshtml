@model PersonalFinance.Application.ViewModels.NetWorth.NetWorthViewModel
@{
    ViewData["Title"] = "ความมั่งคั่งสุทธิ (Net Worth)";
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <h2 class="text-muted mb-2">ความมั่งคั่งสุทธิของคุณ</h2>
        <h1 class="display-3 fw-bold @(Model.NetWorth >= 0 ? "text-success" : "text-danger")">
            ฿@Model.NetWorth.ToString("N2")
        </h1>
        <p class="lead text-muted">สินทรัพย์ทั้งหมด <strong>฿@Model.TotalAssets.ToString("N2")</strong> - หนี้สินทั้งหมด <strong>฿@Model.TotalLiabilities.ToString("N2")</strong></p>
    </div>

    <div class="row">
        <!-- ฝั่งสินทรัพย์ (Assets) -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-cash-stack me-2"></i>สินทรัพย์ (Assets)</h5>
                    <h5 class="mb-0">฿@Model.TotalAssets.ToString("N2")</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.AssetDetails.OrderByDescending(a => a.Amount))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <h6 class="mb-0 fw-bold">@item.Name</h6>
                                    <small class="text-muted">@item.Category</small>
                                </div>
                                <span class="fw-bold text-success">฿@item.Amount.ToString("N2")</span>
                            </li>
                        }
                        @if (!Model.AssetDetails.Any())
                        {
                            <li class="list-group-item text-center text-muted py-4">ยังไม่มีข้อมูลสินทรัพย์</li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- ฝั่งหนี้สิน (Liabilities) -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-credit-card me-2"></i>หนี้สิน (Liabilities)</h5>
                    <h5 class="mb-0">฿@Model.TotalLiabilities.ToString("N2")</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.LiabilityDetails.OrderByDescending(a => a.Amount))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <h6 class="mb-0 fw-bold">@item.Name</h6>
                                    <small class="text-muted">@item.Category</small>
                                </div>
                                <span class="fw-bold text-danger">฿@item.Amount.ToString("N2")</span>
                            </li>
                        }
                        @if (!Model.LiabilityDetails.Any())
                        {
                            <li class="list-group-item text-center text-muted py-4">🎉 ยอดเยี่ยม! คุณไม่มีข้อมูลหนี้สิน</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
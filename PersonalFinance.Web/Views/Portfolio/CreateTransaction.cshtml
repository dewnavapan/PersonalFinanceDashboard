@model PersonalFinance.Application.ViewModels.Portfolio.InvestmentTransactionFormViewModel
@using PersonalFinance.Core.Enums

@{
    ViewData["Title"] = "บันทึกการซื้อขายการลงทุน";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">บันทึกการซื้อ/ขาย สินทรัพย์</h5>
                </div>
                <div class="card-body">
                    <form asp-action="CreateTransaction" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Type" class="form-label">ประเภทรายการ</label>
                                <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<InvestmentTransactionType>()">
                                    <option value="">-- เลือกประเภท --</option>
                                </select>
                                <span asp-validation-for="Type" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Date" class="form-label">วันที่ทำรายการ</label>
                                <input asp-for="Date" class="form-control" type="date" />
                                <span asp-validation-for="Date" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Symbol" class="form-label">สัญลักษณ์ (Symbol)</label>
                                <input asp-for="Symbol" class="form-control" placeholder="เช่น AAPL, BTC" style="text-transform:uppercase" />
                                <span asp-validation-for="Symbol" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AssetType" class="form-label">ประเภทสินทรัพย์</label>
                                <select asp-for="AssetType" class="form-select" asp-items="Html.GetEnumSelectList<AssetType>()">
                                    <option value="">-- เลือกประเภท --</option>
                                </select>
                                <span asp-validation-for="AssetType" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">ชื่อบริษัท / เหรียญ (ใส่เฉพาะครั้งแรกที่สร้าง)</label>
                            <input asp-for="Name" class="form-control" placeholder="เช่น Apple Inc., Bitcoin" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="Quantity" class="form-label">จำนวนหน่วย</label>
                                <input asp-for="Quantity" class="form-control" type="number" step="0.0001" placeholder="0.00" />
                                <span asp-validation-for="Quantity" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Price" class="form-label">ราคาต่อหน่วย (฿)</label>
                                <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="0.00" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Fee" class="form-label">ค่าธรรมเนียม (฿)</label>
                                <input asp-for="Fee" class="form-control" type="number" step="0.01" value="0.00" />
                                <span asp-validation-for="Fee" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary me-2">ยกเลิก</a>
                            <button type="submit" class="btn btn-primary">บันทึกรายการ</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
@model PersonalFinance.Application.ViewModels.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid mt-4">
    <!-- Smart Insights Section -->
    @if (Model.SmartInsights.Any())
    {
        <div class="alert alert-info shadow-sm mb-4">
            <h6 class="alert-heading fw-bold mb-2">💡 Smart Insights</h6>
            <ul class="mb-0">
                @foreach (var insight in Model.SmartInsights)
                {
                    <li>@insight</li>
                }
            </ul>
        </div>
    }

    <!-- Financial Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow-sm h-100">
                <div class="card-body">
                    <h6 class="card-title text-white-50">Net Worth</h6>
                    <h3 class="mb-0">฿@Model.NetWorth.ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white shadow-sm h-100">
                <div class="card-body">
                    <h6 class="card-title text-white-50">รายรับ (Income)</h6>
                    <h3 class="mb-0">฿@Model.TotalIncome.ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white shadow-sm h-100">
                <div class="card-body">
                    <h6 class="card-title text-white-50">รายจ่าย (Expense)</h6>
                    <h3 class="mb-0">฿@Model.TotalExpense.ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white shadow-sm h-100">
                <div class="card-body">
                    <h6 class="card-title text-white-50">Saving Rate</h6>
                    <h3 class="mb-0">@Model.SavingRate.ToString("N0")%</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h6 class="mb-0">สัดส่วนค่าใช้จ่ายเดือนนี้ (Expense by Category)</h6>
                </div>
                <div class="card-body text-center">
                    <!-- พื้นที่แสดง Chart -->
                    <canvas id="expenseChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <!-- พื้นที่สำหรับ Cash Flow Trend Line Chart ในอนาคต -->
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h6 class="mb-0">การตั้งงบประมาณ (Budget Progress) - เร็วๆ นี้</h6>
                </div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <p class="text-muted">ข้อมูลเป้าหมายและงบประมาณจะแสดงในส่วนนี้</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- อิมพอร์ต Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var ctx = document.getElementById('expenseChart').getContext('2d');
            
            // ดึงข้อมูล JSON จาก ViewModel
            var labels = @Html.Raw(Model.ExpenseCategoryLabelsJson);
            var data = @Html.Raw(Model.ExpenseCategoryDataJson);

            if (data.length === 0) {
                // หากไม่มีข้อมูล
                document.getElementById('expenseChart').style.display = 'none';
                ctx.canvas.parentNode.innerHTML += '<p class="text-muted mt-5">ยังไม่มีรายการค่าใช้จ่ายในเดือนนี้</p>';
                return;
            }

            var expenseChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: [
                            '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'right' }
                    }
                }
            });
        });
    </script>
}
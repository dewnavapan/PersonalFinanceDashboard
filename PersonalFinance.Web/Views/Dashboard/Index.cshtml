@model PersonalFinance.Application.ViewModels.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid mt-3">
    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
                <div class="card-body">
                    <h6 class="text-muted">ความมั่งคั่งสุทธิ (Net Worth)</h6>
                    <h3 class="mb-0">฿@Model.NetWorth.ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-info border-4 h-100">
                <div class="card-body">
                    <h6 class="text-muted">เงินคงเหลือ (Total Balance)</h6>
                    <h3 class="mb-0">฿@Model.TotalBalance.ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
                <div class="card-body">
                    <h6 class="text-muted">รายรับเดือนนี้</h6>
                    <h3 class="mb-0 text-success">฿@Model.MonthlyIncome.ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-danger border-4 h-100">
                <div class="card-body">
                    <h6 class="text-muted">รายจ่ายเดือนนี้</h6>
                    <h3 class="mb-0 text-danger">฿@Model.MonthlyExpense.ToString("N2")</h3>
                    <small class="text-muted">อัตราการออม: @Model.SavingRate.ToString("0.0")%</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row mb-4">
        <!-- Bar Chart: 6-Month Cash Flow -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h6 class="mb-0">กระแสเงินสด (6 เดือนย้อนหลัง)</h6>
                </div>
                <div class="card-body">
                    <canvas id="cashFlowChart" height="100"></canvas>
                </div>
            </div>
        </div>
        <!-- Doughnut Chart: Expense By Category -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h6 class="mb-0">สัดส่วนรายจ่าย (เดือนนี้)</h6>
                </div>
                <div class="card-body d-flex justify-content-center">
                    <canvas id="expenseChart" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Transactions -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <h6 class="mb-0">รายการล่าสุด</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>วันที่</th>
                            <th>รายการ</th>
                            <th>หมวดหมู่</th>
                            <th class="text-end">จำนวนเงิน</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tx in Model.RecentTransactions)
                        {
                            <tr>
                                <td>@tx.Date</td>
                                <td>@tx.Description</td>
                                <td><span class="badge bg-secondary">@tx.CategoryName</span></td>
                                <td class="text-end fw-bold @(tx.Type == "Income" ? "text-success" : (tx.Type == "Expense" ? "text-danger" : "text-primary"))">
                                    @(tx.Type == "Income" ? "+" : (tx.Type == "Expense" ? "-" : ""))฿@tx.Amount.ToString("N2")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- โหลด Chart.js จาก CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // ดึงข้อมูล JSON จาก ViewModel
        const expenseLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpenseCategoryLabels));
        const expenseData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpenseCategoryData));
        
        const cfLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CashFlowLabels));
        const cfIncome = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CashFlowIncomeData));
        const cfExpense = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CashFlowExpenseData));

        // 1. Render Expense Doughnut Chart
        const ctxExpense = document.getElementById('expenseChart').getContext('2d');
        new Chart(ctxExpense, {
            type: 'doughnut',
            data: {
                labels: expenseLabels,
                datasets: [{
                    data: expenseData,
                    backgroundColor: ['#ff6384', '#36a2eb', '#cc65fe', '#ffce56', '#4bc0c0', '#f77825', '#9966ff'],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'right' } }
            }
        });

        // 2. Render Cash Flow Bar Chart
        const ctxCashFlow = document.getElementById('cashFlowChart').getContext('2d');
        new Chart(ctxCashFlow, {
            type: 'bar',
            data: {
                labels: cfLabels,
                datasets: [
                    {
                        label: 'รายรับ',
                        data: cfIncome,
                        backgroundColor: '#28a745',
                        borderRadius: 4
                    },
                    {
                        label: 'รายจ่าย',
                        data: cfExpense,
                        backgroundColor: '#dc3545',
                        borderRadius: 4
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'top' } },
                scales: { y: { beginAtZero: true } }
            }
        });
    });
</script>